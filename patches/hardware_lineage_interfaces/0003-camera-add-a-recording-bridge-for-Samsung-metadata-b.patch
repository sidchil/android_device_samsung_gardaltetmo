+// ---- Samsung 4.2 HAL1 recording bridge ------------------------------------
+namespace {
+// Samsung exynos "struct addrs" (kMetadataBufferTypeCameraSource payload)
+struct SamsungRecAddrs {
+    uint32_t type;
+    uint32_t fdY;
+    uint32_t fdCbCr;
+    uint32_t bufIndex;
+    uint32_t reserved;
+};
+const uint_t kBridgeBuffers = 6;
+}
+
+bool CameraDevice::sBridgeEnabled() {
+    static const bool enabled =
+            property_get_bool("ro.camera.legacy.samsung_metadata_bridge", false);
+    return enabled;
+}
+
+void CameraDevice::bridgeStartLocked() {
+    Mutex::Autolock _b(mBridgeLock);
+    uint32_t w = 0, h = 0;
+    if (mDevice->ops->get_parameters) {
+        char* params = mDevice->ops->get_parameters(mDevice);
+        if (params) {
+            const char* vs = strstr(params, "video-size=");
+            if (vs == nullptr || sscanf(vs + strlen("video-size="), "%ux%u", &w, &h) != 2) {
+                const char* ps = strstr(params, "preview-size=");
+                if (ps) sscanf(ps + strlen("preview-size="), "%ux%u", &w, &h);
+            }
+            if (mDevice->ops->put_parameters) {
+                mDevice->ops->put_parameters(mDevice, params);
+            } else {
+                free(params);
+            }
+        }
+    }
+    if (w == 0 || h == 0) {
+        ALOGE("%s: cannot determine video size", __FUNCTION__);
+        return;
+    }
+    if (mBridgeHeap != nullptr && (w != mBridgeW || h != mBridgeH)) {
+        mBridgeHeap->release(mBridgeHeap);
+        mBridgeHeap = nullptr;
+    }
+    mBridgeW = w;
+    mBridgeH = h;
+    if (mBridgeHeap == nullptr) {
+        mBridgeHeap = sGetMemory(-1, w * h * 3 / 2, kBridgeBuffers, nullptr);
+    }
+    mBridgeBusy.assign(kBridgeBuffers, false);
+    mBridgeLogged = false;
+    ALOGI("%s: Samsung recording bridge %ux%u, heap %p", __FUNCTION__, w, h, mBridgeHeap);
+}
+
+void CameraDevice::bridgeStopLocked() {
+    Mutex::Autolock _b(mBridgeLock);
+    for (auto& m : mBridgeMaps) {
+        munmap(m.second.first, m.second.second);
+    }
+    mBridgeMaps.clear();
+    if (mBridgeHeap != nullptr) {
+        mBridgeHeap->release(mBridgeHeap);
+        mBridgeHeap = nullptr;
+    }
+    mBridgeBusy.clear();
+}
+
+void* CameraDevice::bridgeMapFd(int fd, size_t size) {
+    auto it = mBridgeMaps.find(fd);
+    if (it != mBridgeMaps.end() && it->second.second >= size) {
+        return it->second.first;
+    }
+    if (it != mBridgeMaps.end()) {
+        munmap(it->second.first, it->second.second);
+        mBridgeMaps.erase(it);
+    }
+    void* p = mmap(nullptr, size, PROT_READ, MAP_SHARED, fd, 0);
+    if (p == MAP_FAILED) {
+        ALOGE("%s: mmap fd %d (%zu bytes) failed: %s", __FUNCTION__, fd, size, strerror(errno));
+        return nullptr;
+    }
+    mBridgeMaps[fd] = std::make_pair(p, size);
+    return p;
+}
+
+void CameraDevice::bridgeFrame(nsecs_t timestamp, int32_t msgType,
+        CameraHeapMemory* mem, unsigned index) {
+    void* md = (uint8_t*) mem->mHidlHeapMemData + index * mem->mBufSize;
+    int slot = -1;
+    uint32_t heapId = 0;
+    if (mem->mBufSize >= sizeof(SamsungRecAddrs)) {
+        SamsungRecAddrs a = *(SamsungRecAddrs*) md;
+        Mutex::Autolock _b(mBridgeLock);
+        if (!mBridgeLogged) {
+            ALOGI("%s: first frame type %u fdY %u fdCbCr %u idx %u (meta %zu bytes)",
+                    __FUNCTION__, a.type, a.fdY, a.fdCbCr, a.bufIndex, mem->mBufSize);
+            mBridgeLogged = true;
+        }
+        if (mBridgeHeap != nullptr) {
+            for (size_t i = 0; i < mBridgeBusy.size(); i++) {
+                if (!mBridgeBusy[i]) { slot = i; break; }
+            }
+        }
+        if (slot >= 0) {
+            size_t ySize = (size_t) mBridgeW * mBridgeH;
+            size_t cSize = ySize / 2;
+            void* y = bridgeMapFd((int) a.fdY, ySize);
+            void* c = bridgeMapFd((int) a.fdCbCr, cSize);
+            if (y != nullptr && c != nullptr) {
+                uint8_t* dst = (uint8_t*) mBridgeHeap->data + slot * (ySize + cSize);
+                memcpy(dst, y, ySize);
+                memcpy(dst + ySize, c, cSize);
+                mBridgeBusy[slot] = true;
+                heapId = static_cast<CameraHeapMemory*>(mBridgeHeap->handle)->handle.mId;
+            } else {
+                slot = -1;
+            }
+        }
+    }
+    // Return the HAL buffer immediately; the framework only sees the copy.
+    if (mDevice != nullptr && mDevice->ops->release_recording_frame) {
+        mDevice->ops->release_recording_frame(mDevice, md);
+    }
+    if (slot >= 0 && mDeviceCallback != nullptr) {
+        mDeviceCallback->dataCallbackTimestamp(
+                (DataCallbackMsg) msgType, heapId, slot, timestamp);
+    }
+}
